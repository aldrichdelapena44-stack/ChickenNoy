# Copy this file to .env for local development only.
# Do not commit your real .env file to GitHub.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Chickenoy
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated frontend URLs allowed to call the API.
# For local dev you can leave this as-is.
# On Render, set this to your Vercel URL, for example:
# FRONTEND_URLS=https://your-project.vercel.app,https://yourdomain.com
FRONTEND_URLS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500

# Optional admin login for /api/admin/login if your admin route uses these values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
